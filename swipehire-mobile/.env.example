# SwipeHire Mobile — demo environment
# Copy to `.env`. Note that EXPO_PUBLIC_* values are inlined into the JS bundle at build time,
# so nothing secret may ever live here — a backend URL is fine, an API key is not.

# Backend origin, no trailing slash and no path.
# - iOS Simulator:    http://localhost:3000
# - Physical device:  http://<your-mac-LAN-IP>:3000   (localhost resolves to the phone, not your Mac)
# - After DEMO-20:    https://<your-app>.onrender.com
EXPO_PUBLIC_API_URL=http://localhost:3000
