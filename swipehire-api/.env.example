# SwipeHire API — demo environment
# Copy to `.env` and fill in. `.env` is git-ignored and must stay that way
# (Demo Security Baseline §1: no secrets in the repo, ever).
#
# In deployment these live in Railway/Render's encrypted environment-variable panel,
# not in a file (Demo Architecture §7).

# ---- Runtime ----
NODE_ENV=development
PORT=3000

# Comma-separated. Only governs browser-origin requests (Expo web, tooling).
# Leave unset in development to fall back to localhost defaults.
CORS_ORIGINS=

# ---- Database (DEMO-01) ----
# Neon or Supabase Postgres connection string, pgvector extension enabled.
DATABASE_URL=

# ---- Auth (DEMO-03) ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---- File storage (DEMO-02) ----
# Supabase Storage, which Demo Architecture §1 lists as the sanctioned alternative to raw S3.
# Architecture §7 names these S3_*; they're named for what's actually configured instead.
# The bucket is private — resumes are only ever reachable through short-lived signed URLs.
SUPABASE_URL=https://<project-ref>.supabase.co
# Settings → API → service_role. Backend only, never shipped to the client.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=resumes

# ---- Embeddings (DEMO-05b) ----
# Intentionally unused for this build: the embeddings ticket is out of scope and match scoring
# uses the skills-80% / experience-20% fallback (Demo Architecture §5). Kept here so re-enabling
# the semantic factor later is a config change, not a code hunt.
# EMBEDDINGS_API_KEY=
